<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080612">
<title>Profil — MEXA</title>

<style>
:root {
  --bg: #080612;
  --panel: #110d20;
  --panel2: #19122b;
  --line: rgba(166, 117, 255, .22);
  --text: #f8f5ff;
  --muted: #a69bbd;
  --purple: #a855f7;
  --blue: #36cfff;
  --pink: #ff45c8;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  color: var(--text);
  background:
    radial-gradient(ellipse at 15% 0%, #28104d 0, transparent 40%),
    radial-gradient(ellipse at 100% 35%, #081d43 0, transparent 38%),
    var(--bg);
  font-family: Inter, system-ui, -apple-system, Arial, sans-serif;
}

a { color: inherit; text-decoration: none; }
button { font: inherit; cursor: pointer; }

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  min-height: 70px;
  padding: 12px clamp(14px, 4vw, 44px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  background: rgba(8, 6, 18, .88);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(18px);
}

.brand {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 25px;
  font-weight: 950;
  letter-spacing: 1px;
  white-space: nowrap;
  text-shadow: 0 0 20px #a855f755;
}

.brand-m, .brand-a { color: #f8f5ff; }
.brand-x {
  color: var(--blue);
  text-shadow: 0 0 15px #36cfff99;
}

.brand-e {
  width: 15px;
  height: 21px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin: 0 1px;
}

.brand-e i {
  display: block;
  height: 4px;
  width: 15px;
  border-radius: 3px;
  background: var(--purple);
  box-shadow: 0 0 8px #a855f799;
}

.toplinks {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  flex-wrap: wrap;
}

.navlink {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 10px 13px;
  border: 1px solid transparent;
  border-radius: 12px;
  color: #d9d0ec;
  font-size: 13px;
  font-weight: 750;
  transition: .2s;
}

.navlink:hover {
  border-color: var(--line);
  background: #ffffff0b;
  color: white;
}

.navlink.home {
  border-color: #36cfff44;
  color: var(--blue);
}

main {
  width: min(100% - 28px, 1040px);
  margin: 30px auto 60px;
}

.profile-card {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 24px;
  background: linear-gradient(145deg, #171025, #0d0a18 72%);
  box-shadow: 0 20px 70px #0006, 0 0 35px #8b5cf615;
}

.cover {
  position: relative;
  min-height: 220px;
  background:
    radial-gradient(ellipse at 25% 40%, #a855f766, transparent 45%),
    radial-gradient(ellipse at 80% 20%, #36cfff55, transparent 40%),
    linear-gradient(120deg, #180d32, #09182c 65%, #24103a);
  border-bottom: 1px solid var(--line);
}

.cover::after {
  content: "";
  position: absolute;
  inset: 0;
  opacity: .25;
  background-image:
    linear-gradient(120deg, transparent 48%, #ffffff18 49%, transparent 50%),
    linear-gradient(30deg, transparent 48%, #ffffff12 49%, transparent 50%);
  background-size: 42px 42px;
}

.cover-label {
  position: absolute;
  z-index: 1;
  right: 20px;
  bottom: 16px;
  color: #e7dcff;
  font-size: 11px;
  letter-spacing: 3px;
  font-weight: 800;
}

.profile-body { padding: 0 28px 28px; }

.identity {
  display: flex;
  align-items: flex-end;
  gap: 20px;
  margin-top: -58px;
  position: relative;
  z-index: 2;
}

.avatar {
  width: 116px;
  height: 116px;
  flex: 0 0 116px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  border: 4px solid #110d20;
  background: linear-gradient(135deg, #a855f7, #36cfff);
  box-shadow: 0 0 28px #a855f755;
  font-size: 39px;
  font-weight: 950;
}

.identity-text { padding-bottom: 7px; min-width: 0; }

.name {
  margin: 0;
  font-size: clamp(23px, 4vw, 32px);
  font-weight: 900;
  overflow-wrap: anywhere;
}

.username {
  margin-top: 5px;
  color: var(--muted);
  font-size: 14px;
}

.verified {
  display: inline-grid;
  place-items: center;
  width: 17px;
  height: 17px;
  margin-left: 5px;
  border-radius: 50%;
  background: var(--blue);
  color: #06121d;
  font-size: 11px;
  vertical-align: 3px;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 24px;
}

.btn {
  min-height: 43px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 17px;
  border-radius: 12px;
  border: 1px solid var(--line);
  color: white;
  background: #ffffff08;
  font-size: 13px;
  font-weight: 800;
  transition: .2s;
}

.btn:hover { transform: translateY(-1px); }

.btn-primary {
  color: #fff;
  border-color: transparent;
  background: linear-gradient(110deg, #8738e8, #5c43f5);
  box-shadow: 0 5px 22px #8738e833;
}

.btn-cyan {
  border-color: #36cfff55;
  color: var(--blue);
  background: #36cfff0b;
}

.btn:disabled {
  cursor: not-allowed;
  opacity: .55;
  transform: none;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin-top: 25px;
}

.stat {
  padding: 17px;
  border-radius: 15px;
  border: 1px solid var(--line);
  background: #ffffff05;
}

.stat strong {
  display: block;
  font-size: 21px;
  font-weight: 900;
}

.stat span {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: 12px;
}

.bio {
  margin-top: 23px;
  padding: 17px;
  border-radius: 15px;
  background: #ffffff05;
  border: 1px solid var(--line);
}

.section-title {
  margin: 0 0 13px;
  font-size: 15px;
  font-weight: 850;
}

.bio p {
  margin: 0;
  color: #d5cbe7;
  font-size: 14px;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.categories {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 15px;
}

.chip {
  padding: 7px 11px;
  border-radius: 999px;
  color: #d9c4ff;
  border: 1px solid #a855f744;
  background: #a855f710;
  font-size: 11px;
  font-weight: 750;
}

.content-section { margin-top: 24px; }

.tabs {
  display: flex;
  gap: 8px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--line);
}

.tab {
  padding: 10px 15px;
  border-radius: 10px;
  color: var(--muted);
  font-size: 13px;
  font-weight: 800;
}

.tab.active {
  color: white;
  background: #a855f71c;
  border: 1px solid #a855f744;
}

.empty {
  padding: 38px 16px;
  margin-top: 14px;
  text-align: center;
  border: 1px dashed #a855f744;
  border-radius: 17px;
  background: #ffffff03;
}

.empty-icon { font-size: 30px; }

.empty h3 {
  margin: 12px 0 7px;
  font-size: 16px;
}

.empty p {
  max-width: 420px;
  margin: 0 auto;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}

.notice {
  display: none;
  margin-top: 15px;
  padding: 12px 14px;
  border-radius: 12px;
  border: 1px solid #36cfff44;
  background: #36cfff0b;
  color: #bcefff;
  font-size: 12px;
  line-height: 1.6;
}

.notice.show { display: block; }

footer {
  padding: 20px;
  text-align: center;
  color: #817693;
  font-size: 11px;
}

@media (max-width: 620px) {
  .topbar { align-items: flex-start; }
  .brand { font-size: 22px; }
  .toplinks { gap: 4px; }
  .navlink {
    padding: 9px;
    font-size: 12px;
  }
  .navlink .navtext { display: none; }
  main { width: min(100% - 18px, 1040px); margin-top: 16px; }
  .cover { min-height: 165px; }
  .profile-body { padding: 0 16px 19px; }
  .identity { gap: 12px; margin-top: -43px; }
  .avatar { width: 86px; height: 86px; flex-basis: 86px; font-size: 29px; }
  .name { font-size: 22px; }
  .username { font-size: 12px; }
  .actions { margin-top: 20px; }
  .btn { flex: 1 1 auto; padding: 10px 11px; }
  .stat { padding: 13px 9px; }
  .stat strong { font-size: 18px; }
  .stat span { font-size: 11px; }
}
</style>
</head>

<body>
<header class="topbar">
  <a class="brand" href="./index.html" aria-label="MEXA Home">
    <span class="brand-m">M</span>
    <span class="brand-e" aria-label="E"><i></i><i></i><i></i></span>
    <span class="brand-x">X</span>
    <span class="brand-a">A</span>
  </a>

  <nav class="toplinks" aria-label="Navigasi utama">
    <a class="navlink" href="./reels.html">
      <span>🎬</span><span class="navtext">Reels</span>
    </a>
    <a class="navlink" href="./live.html">
      <span>🔴</span><span class="navtext">Live</span>
    </a>
    <a class="navlink home" href="./index.html">
      <span>⌂</span><span class="navtext">Home</span>
    </a>
  </nav>
</header>

<main>
  <article class="profile-card">
    <div class="cover">
      <div class="cover-label">MEXA • YOUR SPACE</div>
    </div>

    <div class="profile-body">
      <div class="identity">
        <div class="avatar" id="avatar">M</div>
        <div class="identity-text">
          <h1 class="name" id="displayName">Profil MEXA</h1>
          <div class="username" id="username">@username</div>
        </div>
      </div>

      <div class="actions" id="actions"></div>
      <div class="notice" id="notice" role="status"></div>

      <div class="stats">
        <div class="stat">
          <strong id="followerCount">—</strong>
          <span>Terhubung</span>
        </div>
        <div class="stat">
          <strong id="friendCount">—</strong>
          <span>Teman</span>
        </div>
        <div class="stat">
          <strong id="postCount">0</strong>
          <span>Postingan</span>
        </div>
      </div>

      <section class="bio">
        <h2 class="section-title">Ruang</h2>
        <p id="bioText">Selamat datang di ruang MEXA-ku.</p>
        <div class="categories" id="categories">
          <span class="chip">Creator Umum</span>
        </div>
      </section>

      <section class="content-section">
        <div class="tabs">
          <a class="tab active" href="#postingan">Postingan</a>
          <a class="tab" href="./reels.html">Reels</a>
        </div>

        <div class="empty" id="postingan">
          <div class="empty-icon">✦</div>
          <h3>Ruang kreator</h3>
          <p id="emptyText">
            Postingan akun akan tampil di sini setelah halaman ini
            dihubungkan ke data MEXA.
          </p>
        </div>
      </section>
    </div>
  </article>
</main>

<footer>© MEXA Hub · Ruang untuk terhubung dan berkarya.</footer>

<script>
/*
 * MODE TAMPILAN SEMENTARA
 * profile.html?mode=visitor menampilkan profil pengunjung.
 * Hapus data contoh ini setelah API profil dan autentikasi terhubung.
 */

const params = new URLSearchParams(location.search);
const isVisitor = params.get("mode") === "visitor";

const profile = {
  displayName: "Santri MEXA",
  username: "santrimexa",
  avatar: "M",
  bio: "Selamat datang di ruang MEXA-ku. Terus terhubung, berbagi, dan berkarya.",
  categories: ["Creator Umum", "Teknologi"],
  followers: "—",
  friends: "—",
  posts: "0"
};

const $ = (id) => document.getElementById(id);

function showNotice(message) {
  const notice = $("notice");
  notice.textContent = message;
  notice.classList.add("show");
}

function renderProfile() {
  $("displayName").textContent = profile.displayName;
  $("username").textContent = "@" + profile.username;
  $("avatar").textContent = profile.avatar || "M";
  $("bioText").textContent = profile.bio;
  $("followerCount").textContent = profile.followers;
  $("friendCount").textContent = profile.friends;
  $("postCount").textContent = profile.posts;

  $("categories").replaceChildren();
  profile.categories.slice(0, 3).forEach((category) => {
    const chip = document.createElement("span");
    chip.className = "chip";
    chip.textContent = category;
    $("categories").appendChild(chip);
  });

  const actions = $("actions");
  actions.replaceChildren();

  if (isVisitor) {
    addButton(actions, "+ Ikuti", "btn btn-primary", () => {
      showNotice(
        "Tampilan profil sudah siap. Follow belum diaktifkan karena perlu validasi akun dan koneksi database yang aman."
      );
    });

    addButton(actions, "✉ Pesan", "btn", () => {
      showNotice("Fitur Pesan akan dihubungkan pada tahap berikutnya.");
    });

    addButton(actions, "•••", "btn", () => {
      showNotice("Menu profil akan tersedia setelah fungsi profil dihubungkan.");
    });
  } else {
    addButton(actions, "✎ Edit Profil", "btn btn-primary", () => {
      showNotice("Editor profil akan dihubungkan ke data akun Supabase.");
    });

    addButton(actions, "+ Reels", "btn btn-cyan", () => {
      location.href = "./reels.html";
    });

    addButton(actions, "🔒 Live", "btn", () => {
      showNotice("Fitur Live masih terkunci sampai kelayakan akun diverifikasi.");
    });
  }
}

function addButton(parent, label, className, onClick) {
  const button = document.createElement("button");
  button.type = "button";
  button.className = className;
  button.textContent = label;
  button.addEventListener("click", onClick);
  parent.appendChild(button);
}

renderProfile();
</script>
</body>
</html>
