
/* ============================================
   MEXA PREMIUM COMMENTS
   File: komentar-premium.js
============================================ */

(function () {
  "use strict";

  let activePostId = null;
  let sending = false;

  function getSupabase() {
    return window.supabaseClient || null;
  }

  function getUser() {
    return window.currentUser || null;
  }

  function notify(message) {
    if (typeof window.showToast === "function") {
      window.showToast(message);
    } else {
      alert(message);
    }
  }

  function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, function (char) {
      const map = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      };
      return map[char];
    });
  }

  function createPanel() {
    let overlay = document.getElementById("mexaCommentsOverlay");
    if (overlay) return overlay;

    overlay = document.createElement("div");
    overlay.id = "mexaCommentsOverlay";
    overlay.className = "mexa-comments-overlay";

    overlay.innerHTML = `
      <section class="mexa-comments-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="mexaCommentsTitle">

        <header class="mexa-comments-header">
          <div>
            <h2 id="mexaCommentsTitle"
              class="mexa-comments-title">
              Komentar MEXA
            </h2>
            <div class="mexa-comments-subtitle">
              Suara komunitas, satu ruang
            </div>
          </div>

          <button type="button"
            class="mexa-comments-close"
            data-mexa-close
            aria-label="Tutup">×</button>
        </header>

        <div id="mexaCommentsList"
          class="mexa-comments-list">
          <div class="mexa-comments-status">
            Memuat komentar...
          </div>
        </div>

        <footer class="mexa-comments-composer">
          <form id="mexaCommentForm"
            class="mexa-comment-form">

            <textarea id="mexaCommentInput"
              class="mexa-comment-input"
              maxlength="2000"
              rows="1"
              placeholder="Tulis komentar kamu..."
              required></textarea>

            <button id="mexaCommentSend"
              class="mexa-comment-send"
              type="submit">Kirim</button>
          </form>
        </footer>
      </section>
    `;

    document.body.appendChild(overlay);

    overlay.addEventListener("click", function (event) {
      if (
        event.target === overlay ||
        event.target.closest("[data-mexa-close]")
      ) {
        close();
        return;
      }

      const deleteButton = event.target.closest(
        "[data-mexa-delete]"
      );

      if (deleteButton) {
        removeComment(deleteButton.dataset.mexaDelete);
      }
    });

    overlay.querySelector("#mexaCommentForm")
      .addEventListener("submit", sendComment);

    return overlay;
  }

  function close() {
    const overlay = document.getElementById("mexaCommentsOverlay");

    if (overlay) {
      overlay.classList.remove("is-open");
    }

    activePostId = null;
  }

  async function open(postId) {
    const user = getUser();
    const db = getSupabase();

    if (!user) {
      notify("Silakan login untuk berkomentar.");
      return;
    }

    if (!db) {
      notify("Supabase belum terhubung. Periksa konfigurasi MEXA.");
      console.error("MEXA Comments: window.supabaseClient tidak ditemukan.");
      return;
    }

    if (!postId) {
      notify("ID postingan tidak ditemukan.");
      return;
    }

    activePostId = postId;

    const overlay = createPanel();
    overlay.classList.add("is-open");

    await load();
  }

  async function load() {
    const db = getSupabase();
    const list = document.getElementById("mexaCommentsList");

    if (!db || !activePostId || !list) return;

    list.innerHTML =
      '<div class="mexa-comments-status">Memuat komentar...</div>';

    try {
      const { data: comments, error } = await db
        .from("post_comments")
        .select("id, post_id, user_id, content, created_at")
        .eq("post_id", activePostId)
        .order("created_at", { ascending: true });

      if (error) throw error;

      if (!comments || comments.length === 0) {
        list.innerHTML =
          '<div class="mexa-comments-status">Belum ada komentar. Jadilah yang pertama!</div>';
        return;
      }

      const userIds = [...new Set(comments.map(function (item) {
        return item.user_id;
      }))];

      const { data: profiles, error: profileError } = await db
        .from("profiles")
        .select("id, display_name, username, avatar_url")
        .in("id", userIds);

      if (profileError) {
        console.warn("MEXA: Profil komentar gagal dimuat.", profileError);
      }

      const profileMap = new Map(
        (profiles || []).map(function (profile) {
          return [profile.id, profile];
        })
      );

      list.innerHTML = comments.map(function (comment) {
        const profile = profileMap.get(comment.user_id) || {};
        const name =
          profile.display_name ||
          profile.username ||
          "Pengguna MEXA";

        const avatar = profile.avatar_url
          ? `<img class="mexa-comment-avatar"
               src="${escapeHTML(profile.avatar_url)}"
               alt=""
               loading="lazy">`
          : `<div class="mexa-comment-avatar"
               aria-hidden="true"></div>`;

        const isOwner =
          getUser() && getUser().id === comment.user_id;

        return `
          <article class="mexa-comment-item">
            ${avatar}

            <div class="mexa-comment-body">
              <div class="mexa-comment-bubble">
                <div class="mexa-comment-name">
                  ${escapeHTML(name)}
                </div>

                <div class="mexa-comment-text">
                  ${escapeHTML(comment.content)}
                </div>
              </div>

              <div class="mexa-comment-actions">
                ${
                  isOwner
                    ? `<button type="button"
                         class="mexa-comment-action"
                         data-mexa-delete="${escapeHTML(comment.id)}">
                         Hapus komentar
                       </button>`
                    : ""
                }
              </div>
            </div>
          </article>
        `;
      }).join("");

    } catch (error) {
      console.error("MEXA load comments:", error);

      list.innerHTML =
        '<div class="mexa-comments-status">Gagal memuat komentar. Periksa izin Supabase.</div>';
    }
  }

  async function sendComment(event) {
    event.preventDefault();

    if (sending) return;

    const user = getUser();
    const db = getSupabase();
    const input = document.getElementById("mexaCommentInput");
    const button = document.getElementById("mexaCommentSend");

    if (!user) {
      notify("Silakan login untuk berkomentar.");
      return;
    }

    if (!db || !activePostId || !input || !button) return;

    const content = input.value.trim();

    if (!content) {
      notify("Komentar tidak boleh kosong.");
      return;
    }

    sending = true;
    button.disabled = true;

    try {
      const { error } = await db
        .from("post_comments")
        .insert({
          post_id: activePostId,
          user_id: user.id,
          content: content
        });

      if (error) throw error;

      input.value = "";
      await load();
      notify("Komentar berhasil dikirim.");

      if (typeof window.loadPosts === "function") {
        await window.loadPosts();
      }

    } catch (error) {
      console.error("MEXA send comment:", error);
      notify("Gagal mengirim komentar. Periksa izin tabel post_comments.");
    } finally {
      sending = false;
      button.disabled = false;
    }
  }

  async function removeComment(commentId) {
    const user = getUser();
    const db = getSupabase();

    if (!user || !db || !commentId) return;

    const confirmed = window.confirm(
      "Hapus komentar kamu? Tindakan ini tidak dapat dibatalkan."
    );

    if (!confirmed) return;

    try {
      const { error } = await db
        .from("post_comments")
        .delete()
        .eq("id", commentId)
        .eq("user_id", user.id);

      if (error) throw error;

      notify("Komentar berhasil dihapus.");
      await load();

      if (typeof window.loadPosts === "function") {
        await window.loadPosts();
      }

    } catch (error) {
      console.error("MEXA delete comment:", error);
      notify("Gagal menghapus komentar. Periksa kebijakan Supabase.");
    }
  }

  window.MEXAComments = {
    open: open,
    close: close,
    reload: load
  };

  window.openComments = open;

  console.log("MEXA Premium Comments siap.");
})();
