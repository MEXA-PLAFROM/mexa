/* ==================================================
   MEXA — RUANG KREATOR
   Memuat postingan profil dari MEXA API
   ================================================== */

(function () {
  "use strict";

  const container = document.getElementById("postingan");

  if (!container) return;

  let activeUserId = null;
  let loadSequence = 0;

  function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, function (char) {
      return {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      }[char];
    });
  }

  function safeURL(value) {
    if (!value) return "";

    try {
      const url = new URL(String(value), location.href);

      if (url.protocol !== "https:" && url.protocol !== "http:") {
        return "";
      }

      return url.href;
    } catch {
      return "";
    }
  }

  function isVideo(post) {
    const type = String(
      post.media_type ||
      post.type ||
      post.mediaType ||
      ""
    ).toLowerCase();

    if (type.includes("video") || type.includes("reel")) {
      return true;
    }

    const url = String(
      post.video_url ||
      post.media_url ||
      post.image_url ||
      ""
    ).split("?")[0].toLowerCase();

    return /\.(mp4|webm|mov|m4v|ogv)$/.test(url);
  }

  function mediaURL(post, video) {
    return safeURL(
      video
        ? (
            post.video_url ||
            post.media_url ||
            post.image_url ||
            ""
          )
        : (
            post.image_url ||
            post.media_url ||
            ""
          )
    );
  }

  function authorName(post) {
    return String(
      post.display_name ||
      post.profiles?.display_name ||
      post.username ||
      post.profiles?.username ||
      "Kreator MEXA"
    );
  }

  function authorAvatar(post) {
    return safeURL(
      post.avatar_url ||
      post.profiles?.avatar_url ||
      ""
    );
  }

  function formatDate(value) {
    if (!value) return "Postingan kreator";

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "Postingan kreator";
    }

    return date.toLocaleString("id-ID", {
      dateStyle: "medium",
      timeStyle: "short"
    });
  }

  function loading(message) {
    container.innerHTML = `
      <div class="creator-state">
        <div class="creator-state-icon">✦</div>
        <h3>Ruang Kreator</h3>
        <p>${escapeHTML(message)}</p>
      </div>
    `;
  }

  function renderPosts(posts) {
    if (!Array.isArray(posts) || posts.length === 0) {
      loading("Belum ada postingan di ruang kreator ini.");
      return;
    }

    container.innerHTML = posts.map(function (post) {
      const video = isVideo(post);
      const media = mediaURL(post, video);
      const name = authorName(post);
      const avatar = authorAvatar(post);
      const content = String(post.content || "");
      const date = formatDate(post.created_at);

      const initial = escapeHTML(
        name.trim().charAt(0).toUpperCase() || "M"
      );

      let mediaHTML = "";

      if (media && video) {
        mediaHTML = `
          <div class="creator-media creator-video">
            <video
              src="${escapeHTML(media)}"
              controls
              playsinline
              preload="metadata"
            ></video>
          </div>
        `;
      } else if (media) {
        mediaHTML = `
          <div class="creator-media creator-photo">
            <img
              src="${escapeHTML(media)}"
              alt="Foto dari ${escapeHTML(name)}"
              loading="lazy"
            >
          </div>
        `;
      }

      return `
        <article class="creator-post">
          <header class="creator-post-header">
            <div class="creator-avatar">
              ${
                avatar
                  ? `<img src="${escapeHTML(avatar)}" alt="">`
                  : `<span>${initial}</span>`
              }
            </div>

            <div class="creator-author">
              <strong>${escapeHTML(name)}</strong>
              <span class="creator-badge">
                ${video ? "▶ Video Kreator" : "✦ Foto Kreator"}
              </span>
              <time>${escapeHTML(date)}</time>
            </div>
          </header>

          ${
            content
              ? `<div class="creator-caption">${escapeHTML(content)}</div>`
              : ""
          }

          ${mediaHTML}

          <footer class="creator-post-footer">
            <span>♡ ${Number(post.likes_count || post.like_count || 0)} Suka</span>
            <span>▢ ${Number(post.comments_count || post.comment_count || 0)} Komentar</span>
            <span>↗ ${Number(post.shares_count || post.share_count || 0)} Bagikan</span>
          </footer>
        </article>
      `;
    }).join("");

    const postCount = container.querySelectorAll(".creator-post").length;
    const countElement = document.getElementById("posts");

    if (countElement) {
      countElement.textContent = String(postCount);
    }
  }

  async function loadPosts(userId) {
    if (!userId) return;

    const sequence = ++loadSequence;
    activeUserId = userId;

    loading("Mengambil postingan dari MEXA...");

    try {
      if (!window.MEXAApi ||
          typeof window.MEXAApi.request !== "function") {
        throw new Error(
          "MEXA API belum tersedia. Periksa pemuatan mexa-api-client.js."
        );
      }

      const result = await window.MEXAApi.request("get_posts");

      if (sequence !== loadSequence) return;

      if (!result || result.success !== true) {
        throw new Error(
          result?.error || result?.message || "Gagal mengambil postingan."
        );
      }

      const allPosts = Array.isArray(result.posts)
        ? result.posts
        : Array.isArray(result.data?.posts)
          ? result.data.posts
          : [];

      const posts = allPosts.filter(function (post) {
        return String(post.user_id || post.author_id || "") ===
          String(userId);
      });

      renderPosts(posts);

    } catch (error) {
      if (sequence !== loadSequence) return;

      console.error("MEXA Ruang Kreator:", error);

      loading(
        error?.message ||
        "Postingan belum dapat dimuat. Silakan coba lagi."
      );

      const retry = document.createElement("button");
      retry.type = "button";
      retry.className = "creator-retry";
      retry.textContent = "Coba Lagi";
      retry.addEventListener("click", function () {
        loadPosts(activeUserId);
      });

      container.appendChild(retry);
    }
  }

  document.addEventListener("mexa:profile-ready", function (event) {
    const userId = event.detail?.userId;

    if (userId) loadPosts(userId);
  });

  // Mendukung halaman yang sudah selesai memuat profil
  // sebelum modul ini dijalankan.
  if (window.MEXA_PROFILE_TARGET_ID) {
    loadPosts(window.MEXA_PROFILE_TARGET_ID);
  }
})();
